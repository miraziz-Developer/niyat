# NIYAT server settings. ./scripts/server-up.sh creates and maintains .env for you;
# copy this file only when configuring by hand. Every variable is explained in DEPLOY.md.

# --- Database (passwords are generated by server-up.sh; never change POSTGRES_PASSWORD after the first start)
POSTGRES_DB=niyat
POSTGRES_USER=niyat
POSTGRES_PASSWORD=replace_with_a_long_random_password
# The API connects as this least-privilege role so PostgreSQL row-level security is enforced.
NIYAT_APP_DB_USER=niyat_app
NIYAT_APP_DB_PASSWORD=replace_with_a_different_long_random_password
DATABASE_POOL_SIZE=10
NIYAT_POSTGRES_PORT=55432
NIYAT_BACKUP_KEEP=14

# --- Network
# With a domain: Caddy terminates HTTPS (Let's Encrypt) and the web port stays on localhost.
# NIYAT_DOMAIN=niyat.example.uz
# APP_ORIGIN=https://niyat.example.uz
# COMPOSE_PROFILES=https
# NIYAT_HTTP_BIND=127.0.0.1
NIYAT_HTTP_BIND=0.0.0.0
NIYAT_HTTP_PORT=8080

# --- Sign-in
# local: test-only bootstrap that signs the browser in as VITE_DEV_USER_ID (refused in production).
# email: invite-only magic links. Needs APP_ORIGIN, MAIL_FROM and RESEND_API_KEY; leave VITE_DEV_USER_ID empty.
NIYAT_NODE_ENV=development
AUTH_MODE=local
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000001
# MAIL_FROM="NIYAT <kirish@niyat.example.uz>"
# Never commit a real key; create it in the Resend dashboard and put it only in the server's .env.
# RESEND_API_KEY=re_...
# Invited automatically by server-up.sh.
# NIYAT_ADMIN_EMAIL=you@example.uz

# Shown on /maxfiylik for privacy and deletion requests (baked into the web build).
# VITE_CONTACT_EMAIL=privacy@niyat.example.uz
