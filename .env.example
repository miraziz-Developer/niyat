# Copy to .env only when configuring manually. server-up.sh creates it automatically.
POSTGRES_DB=niyat
POSTGRES_USER=niyat
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_POOL_SIZE=10

# The API connects as this least-privilege role so PostgreSQL row-level security is enforced.
NIYAT_APP_DB_USER=niyat_app
NIYAT_APP_DB_PASSWORD=replace_with_a_different_long_random_password
NIYAT_HTTP_PORT=8080
NIYAT_POSTGRES_PORT=55432

# Sign-in.
# local: private-alpha bootstrap that signs the browser in as VITE_DEV_USER_ID (refused in production).
# email: invite-only magic links. Set APP_ORIGIN, MAIL_FROM and RESEND_API_KEY, leave VITE_DEV_USER_ID empty,
#        then invite people with: docker compose run --rm migrate npm run invite -- someone@example.uz
NIYAT_NODE_ENV=development
AUTH_MODE=local
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000001
# APP_ORIGIN=https://niyat.example.uz
# MAIL_FROM=NIYAT <kirish@niyat.example.uz>
# Never commit a real key; create it in the Resend dashboard and put it only in the server's .env.
# RESEND_API_KEY=re_...